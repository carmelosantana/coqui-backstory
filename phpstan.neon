parameters:
    level: 8
    # Analyse production code only — matching coqui core (which phpstans src, not
    # tests). Pest test closures trip L8 with framework-inherent false positives
    # ($this binding, expect() chain narrowing, test()->markTestSkipped() unions);
    # the test suite is validated by running it (composer test), not static analysis.
    paths:
        - src
    scanFiles:
        - stubs/coqui_repl_contracts.php
    tmpDir: .phpstan-cache
